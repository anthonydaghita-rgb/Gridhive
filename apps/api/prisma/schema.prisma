generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String?
  emailVerified Boolean @default(false)
  image        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orgMembers       OrgMember[]
  projects         Project[]    @relation("ProjectCreator")
  versions         ProjectVersion[] @relation("VersionCreator")
  validations      ValidationRun[]
  simulations      SimulationRun[]
  templates        Template[]
  auditLogs        AuditLog[]
  sessions         Session[]
  accounts         Account[]
  favorites        UserProjectFavorite[]
  comments         ProjectComment[]
  scoutDiscoveries ScoutDiscovery[]     @relation("ScoutCreator")
  apiCredentials   OrgApiCredential[]   @relation("CredentialCreator")
  apiKeys          OrgApiKey[]          @relation("ApiKeyCreator")
  webhooks         OrgWebhook[]         @relation("WebhookCreator")
  alertRules       MonitoringAlertRule[] @relation("AlertRuleCreator")
  nodeLocks        ProjectNodeLock[]    @relation("NodeLockUser")

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  accountId         String
  providerId        String
  accessToken       String?
  refreshToken      String?
  accessTokenExpiresAt DateTime?
  refreshTokenExpiresAt DateTime?
  scope             String?
  idToken           String?
  password          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verifications")
}

model Organization {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  contactEmail String?
  logoBase64   String?
  createdAt    DateTime @default(now())

  members          OrgMember[]
  projects         Project[]
  folders          Folder[]
  templates        Template[]
  auditLogs        AuditLog[]
  scoutDiscoveries ScoutDiscovery[]
  apiCredentials   OrgApiCredential[]
  apiKeys          OrgApiKey[]
  webhooks         OrgWebhook[]

  @@map("organizations")
}

model Folder {
  id          String    @id @default(cuid())
  orgId       String
  name        String
  description String?
  color       String?
  createdBy   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  projects Project[]

  @@map("folders")
}

model OrgMember {
  id       String   @id @default(cuid())
  orgId    String
  userId   String
  role     String   @default("member")
  joinedAt DateTime @default(now())

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@map("org_members")
}

model Project {
  id             String    @id @default(cuid())
  orgId          String
  folderId       String?
  name           String
  description    String?
  clientName     String?
  tags           String[]  @default([])
  defaultIpRange String?
  canvasTheme    String?   @default("dark")
  snapToGrid     Boolean   @default(true)
  gridSize       Int       @default(20)
  createdBy      String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  archived       Boolean   @default(false)
  archivedAt     DateTime?
  archivedBy     String?

  org              Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  folder           Folder?          @relation(fields: [folderId], references: [id])
  creator          User             @relation("ProjectCreator", fields: [createdBy], references: [id])
  versions         ProjectVersion[]
  validations      ValidationRun[]
  simulations      SimulationRun[]
  auditLogs        AuditLog[]
  favorites        UserProjectFavorite[]
  comments         ProjectComment[]
  searchIndex      ProjectSearchIndex[]
  scoutDiscoveries ScoutDiscovery[]
  monitoringSnaps  MonitoringSnapshot[]
  alertRules       MonitoringAlertRule[]
  alertEvents      MonitoringAlertEvent[]
  nodeLocks        ProjectNodeLock[]

  @@map("projects")
}

model ProjectVersion {
  id              String   @id @default(cuid())
  projectId       String
  versionNumber   Int
  label           String?
  topology        Json
  thumbnailBase64 String?
  createdBy       String
  createdAt       DateTime @default(now())
  isAutosave      Boolean  @default(false)

  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator     User            @relation("VersionCreator", fields: [createdBy], references: [id])
  validations ValidationRun[]
  simulations SimulationRun[]

  @@unique([projectId, versionNumber])
  @@map("project_versions")
}

model Template {
  id                  String   @id @default(cuid())
  orgId               String?
  name                String
  slug                String   @unique
  description         String?
  category            String
  isSystem            Boolean  @default(false)
  topology            Json
  thumbnail           String?
  difficulty          String   @default("beginner")
  tags                String[]
  validationExpected  String   @default("pass")
  simTestSuite        Json     @default("[]")
  createdBy           String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  version             String   @default("1.0.0")

  org     Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)
  creator User?         @relation(fields: [createdBy], references: [id])

  @@map("templates")
}

model ValidationRun {
  id        String   @id @default(cuid())
  projectId String
  versionId String?
  ranAt     DateTime @default(now())
  ranBy     String
  results   Json

  project Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version ProjectVersion? @relation(fields: [versionId], references: [id])
  user    User           @relation(fields: [ranBy], references: [id])

  @@map("validation_runs")
}

model SimulationRun {
  id        String   @id @default(cuid())
  projectId String
  versionId String?
  ranAt     DateTime @default(now())
  ranBy     String
  testCases Json
  results   Json

  project Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version ProjectVersion? @relation(fields: [versionId], references: [id])
  user    User           @relation(fields: [ranBy], references: [id])

  @@map("simulation_runs")
}

model AuditLog {
  id         String   @id @default(cuid())
  orgId      String?
  projectId  String?
  userId     String
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  org     Organization? @relation(fields: [orgId], references: [id])
  project Project?      @relation(fields: [projectId], references: [id])
  user    User          @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────
// Phase 4 Migration 1: Project Management
// ─────────────────────────────────────────────────────────────

model ProjectSearchIndex {
  id         String   @id @default(cuid())
  projectId  String
  hostname   String?
  ipAddress  String?
  deviceType String?
  updatedAt  DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([hostname])
  @@index([ipAddress])
  @@map("project_search_index")
}

model UserProjectFavorite {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@map("user_project_favorites")
}

model ProjectComment {
  id        String   @id @default(cuid())
  projectId String
  nodeId    String?
  userId    String
  content   String
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@index([projectId])
  @@map("project_comments")
}

// ─────────────────────────────────────────────────────────────
// Phase 4 Migration 2: Scout Discoveries
// ─────────────────────────────────────────────────────────────

model ScoutDiscovery {
  id               String    @id @default(cuid())
  orgId            String
  projectId        String?
  createdBy        String
  pairingTokenHash String
  scanMode         String    @default("standard")
  status           String    @default("pending")
  startedAt        DateTime?
  completedAt      DateTime?
  summary          Json?
  topologySnapshot Json?
  appliedAt        DateTime?
  appliedBy        String?
  scoutVersion     String?
  hostOs           String?
  hostIp           String?
  expiresAt        DateTime?
  createdAt        DateTime  @default(now())

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project Project?     @relation(fields: [projectId], references: [id])
  creator User         @relation("ScoutCreator", fields: [createdBy], references: [id])

  @@index([orgId])
  @@index([status])
  @@map("scout_discoveries")
}

// ─────────────────────────────────────────────────────────────
// Phase 4 Migration 3: API Credentials (Live Push)
// ─────────────────────────────────────────────────────────────

model OrgApiCredential {
  id             String    @id @default(cuid())
  orgId          String
  vendor         String
  credentialType String
  encryptedData  String
  label          String
  testedAt       DateTime?
  testResult     String?
  createdBy      String
  createdAt      DateTime  @default(now())

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  creator User         @relation("CredentialCreator", fields: [createdBy], references: [id])

  @@index([orgId, vendor])
  @@map("org_api_credentials")
}

// ─────────────────────────────────────────────────────────────
// Phase 4 Migration 4: Monitoring
// ─────────────────────────────────────────────────────────────

model MonitoringSnapshot {
  id            String   @id @default(cuid())
  projectId     String
  deviceId      String
  polledAt      DateTime @default(now())
  status        String
  uptimeSeconds Int?
  cpuPct        Float?
  memoryPct     Float?
  data          Json?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, deviceId])
  @@index([polledAt])
  @@map("monitoring_snapshots")
}

model MonitoringAlertRule {
  id           String    @id @default(cuid())
  projectId    String
  deviceId     String?
  ruleType     String
  threshold    Float?
  notifyEmails String[]  @default([])
  enabled      Boolean   @default(true)
  createdBy    String
  createdAt    DateTime  @default(now())

  project      Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator      User                   @relation("AlertRuleCreator", fields: [createdBy], references: [id])
  alertEvents  MonitoringAlertEvent[] @relation("AlertEvents")

  @@index([projectId])
  @@map("monitoring_alert_rules")
}

model MonitoringAlertEvent {
  id          String    @id @default(cuid())
  projectId   String
  deviceId    String
  ruleId      String
  triggeredAt DateTime  @default(now())
  resolvedAt  DateTime?
  summary     String

  project Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  rule    MonitoringAlertRule @relation("AlertEvents", fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("monitoring_alert_events")
}

// ─────────────────────────────────────────────────────────────
// Phase 4 Migration 5: External API Access
// ─────────────────────────────────────────────────────────────

model OrgApiKey {
  id         String    @id @default(cuid())
  orgId      String
  keyHash    String    @unique
  label      String
  scopes     String[]  @default([])
  createdBy  String
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  creator User         @relation("ApiKeyCreator", fields: [createdBy], references: [id])

  @@index([orgId])
  @@map("org_api_keys")
}

model OrgWebhook {
  id        String   @id @default(cuid())
  orgId     String
  url       String
  events    String[] @default([])
  secretHash String?
  enabled   Boolean  @default(true)
  createdBy String
  createdAt DateTime @default(now())

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  creator User         @relation("WebhookCreator", fields: [createdBy], references: [id])

  @@index([orgId])
  @@map("org_webhooks")
}

// ─────────────────────────────────────────────────────────────
// Phase 4 Migration 6: Collaboration Locks
// ─────────────────────────────────────────────────────────────

model ProjectNodeLock {
  id        String   @id @default(cuid())
  projectId String
  nodeId    String
  lockedBy  String
  lockedAt  DateTime @default(now())
  expiresAt DateTime

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  lockUser User    @relation("NodeLockUser", fields: [lockedBy], references: [id])

  @@unique([projectId, nodeId])
  @@map("project_node_locks")
}
